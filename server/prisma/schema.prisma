generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum POStatus {
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum POItemStatus {
  ORDERED
  PARTIAL
  RECEIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  medicines Medicine[]
}

model Medicine {
  id              String   @id @default(cuid())
  name            String
  genericFormula  String?
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  lowStockThreshold Int    @default(10)
  expiryAlertDays   Int?   // per-medicine override; null = use global
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  batches         MedicineBatch[]
  poItems         PurchaseOrderItem[]

  @@unique([name, categoryId])
  @@index([name])
}

model MedicineBatch {
  id            String   @id @default(cuid())
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber   String
  expiryDate    DateTime
  quantity      Int      @default(0)
  purchasePrice Decimal  @db.Decimal(12, 2)
  mrp           Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  saleItems     SaleItem[]
  supplierReturns SupplierReturnItem[]

  @@unique([medicineId, batchNumber])
  @@index([expiryDate])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  purchaseOrders PurchaseOrder[]
  supplierReturns SupplierReturn[]
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  status      POStatus @default(ORDERED)
  notes       String?
  orderedAt   DateTime @default(now())
  receivedAt  DateTime?
  updatedAt   DateTime @updatedAt
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id                String       @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine     @relation(fields: [medicineId], references: [id])
  quantityOrdered   Int
  quantityReceived  Int          @default(0)
  status            POItemStatus @default(ORDERED)
  lastReceivedAt    DateTime?
}

model Sale {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  cashierId     String
  cashier       User     @relation(fields: [cashierId], references: [id])
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  items         SaleItem[]
  customerReturns CustomerReturn[]
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batchId     String
  batch       MedicineBatch @relation(fields: [batchId], references: [id])
  medicineName String
  batchNumber String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  returnedQty Int      @default(0)
  customerReturnItems CustomerReturnItem[]
}

model CustomerReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
  creditAmount  Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  items         CustomerReturnItem[]
}

model CustomerReturnItem {
  id               String   @id @default(cuid())
  customerReturnId String
  customerReturn   CustomerReturn @relation(fields: [customerReturnId], references: [id], onDelete: Cascade)
  saleItemId       String
  saleItem         SaleItem @relation(fields: [saleItemId], references: [id])
  quantity         Int
}

model SupplierReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  reason        String?
  debitAmount   Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  items         SupplierReturnItem[]
}

model SupplierReturnItem {
  id               String   @id @default(cuid())
  supplierReturnId String
  supplierReturn   SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  batchId          String
  batch            MedicineBatch @relation(fields: [batchId], references: [id])
  quantity         Int
  unitCost         Decimal  @db.Decimal(12, 2)
}

model AlertSettings {
  id                  String @id @default("global")
  globalExpiryLeadDays Int   @default(30)
  updatedAt           DateTime @updatedAt
}

model StockReceipt {
  id          String   @id @default(cuid())
  source      String   // MANUAL | AI_BILL
  reference   String?
  createdAt   DateTime @default(now())
}